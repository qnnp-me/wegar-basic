<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         colors="true"
         cacheDirectory=".phpunit.cache">
  <source>
    <include>
      <directory>src</directory>
    </include>
    <exclude>
      <directory>src/config</directory>
      <!-- 进程/CLI 边界：仅由集成套件（子进程 `php webman`/phar）行为覆盖，
           pcov 无法在进程内采集，故不计入 Unit 覆盖率门禁。理由见
           docs/superpowers/specs/2026-09-21-testing-strategy-design.md §L4。 -->
      <file>src/Command/Phinx.php</file>
      <file>src/Command/Updater.php</file>
      <file>src/Helper/CronHelper.php</file>
      <file>src/Helper/PhinxHelper.php</file>
      <file>src/Init/CheckFilesDirectories.php</file>
      <file>src/Init/Phinx.php</file>
      <file>src/Init/ReleaseFiles.php</file>
      <file>src/Install.php</file>
      <file>src/Process/InitProcess.php</file>
    </exclude>
  </source>
  <php>
    <!-- 颜色用例断言数字色号产生的 ANSI 转义，php-console-color 的
         256 色判断依赖 TERM 含 "256color"，CI 未设置 TERM 会退化为纯文本。
         固定测试进程的 TERM，使断言不依赖运行环境。 -->
    <env name="TERM" value="xterm-256color" force="true"/>
  </php>
  <testsuites>
    <testsuite name="Unit">
      <directory>tests/Unit</directory>
    </testsuite>
    <testsuite name="Integration">
      <directory>tests/Integration</directory>
    </testsuite>
  </testsuites>
</phpunit>
