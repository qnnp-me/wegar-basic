{
  "name": "wegar/basic",
  "type": "library",
  "license": "MIT",
  "description": "Webman plugin wegar/basic",
  "require": {
    "php": ">=8.3",
    "monolog/monolog": "^2.10 || ^3.0",
    "php-parallel-lint/php-console-color": "^1.0",
    "robmorgan/phinx": "^0.16",
    "sebastian/diff": "^6.0 || ^7.0 || ^8.0 || ^9.0",
    "symfony/console": "^6.4 || ^7.0 || ^8.0",
    "vlucas/phpdotenv": "^4.0 || ^5.0",
    "webman/console": "^2.0",
    "webman/database": "^2.0",
    "workerman/webman-framework": "^2.0"
  },
  "autoload": {
    "files": [
      "src/functions_psr.php",
      "src/functions.php"
    ],
    "psr-4": {
      "Wegar\\Basic\\": "src"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/",
      "config\\": "src/config/"
    }
  },
  "require-dev": {
    "phpunit/phpunit": "^12.1 || ^13.0",
    "webman/redis-queue": "^2.1",
    "workerman/crontab": "^1.0",
    "phpstan/phpstan": "^2.1",
    "friendsofphp/php-cs-fixer": "^3.64"
  },
  "scripts": {
    "test": "phpunit --testsuite Unit",
    "analyse": "phpstan analyse --no-progress",
    "lint": "php-cs-fixer fix --dry-run --diff",
    "test:coverage": [
      "@php vendor/bin/phpunit --testsuite Unit --coverage-clover build/coverage/clover.xml --coverage-text",
      "@php tests/scripts/coverage-threshold.php build/coverage/clover.xml 47"
    ],
    "host:setup": "@php tests/scripts/host-setup.php",
    "test:integration": "phpunit --testsuite Integration",
    "check": [
      "@composer validate --strict",
      "@lint",
      "@analyse",
      "@test"
    ]
  },
  "config": {
    "platform": {
      "php": "8.3.99"
    }
  }
}
